{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "strictFunctionTypes": false,
    "declaration": true,
    "isolatedModules": true,

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    /* TS7 では rootDir の既定値が tsconfig のディレクトリになるため明示する */
    "rootDir": "./",
    "outDir": "./dist",

    /* TS7 では types の既定値が [] のため、必要な型を明示する */
    "types": [
      "vitest/globals",
      "@webgpu/types"
    ]
  },
  "include": [
    "src/index.ts",
    "packages/**/*.ts",
    "@types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "**/dist/**",
    "**/build/**",
    "scripts",
    "dist",
    "**/*.test.ts",
    "**/.github"
  ]
}
